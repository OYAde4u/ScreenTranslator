<Window x:Class="ScreenTranslator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="屏幕实时翻译" Height="520" Width="600"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="16">
        <TextBlock FontSize="16" FontWeight="Bold" Text="屏幕实时翻译:截图 → OCR → 覆盖"/>
        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#666"
                   Text="Ctrl+Shift+T 或点按钮:截图 → OCR(带位置)→ 覆盖层按原文位置抹背景写文本。勾选自动触发后,鼠标点击/滚轮/键盘按键(300ms 防抖)自动触发,只翻变化区域。"/>
        <Button x:Name="BtnTest" Margin="0,12,0,0" Padding="8,4" Content="测试:截图 + 识别 + 覆盖" Click="OnTestClick"/>
        <Button x:Name="BtnDemo" Margin="0,8,0,0" Padding="8,4" Content="演示:英文测试页 + 自动翻译(先看效果)" Click="OnDemoClick"/>
        <Button x:Name="BtnClear" Margin="0,8,0,0" Padding="8,4" Content="清除覆盖层" Click="OnClearClick"/>
        <CheckBox x:Name="ChkAuto" Margin="0,10,0,0" Content="自动触发(点击/滚轮/按键,防抖 300ms,只翻变化区域)"
                  Checked="OnAutoChecked" Unchecked="OnAutoUnchecked"/>
        <CheckBox x:Name="ChkSaveShot" Margin="0,6,0,0" Content="保存调试截图(每帧全屏 PNG,慢,默认关)"
                  IsChecked="False"/>
        <CheckBox x:Name="ChkWidget" Margin="0,6,0,0" Content="悬浮状态框(游戏时查看翻译进度/快捷切换模式)"
                  IsChecked="True" Checked="OnWidgetChecked" Unchecked="OnWidgetUnchecked"/>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="目标语言:" VerticalAlignment="Center"/>
            <ComboBox x:Name="LangBox" Width="130" SelectedIndex="0" SelectionChanged="OnLangChanged">
                <ComboBoxItem Content="中文 ZH" Tag="ZH"/>
                <ComboBoxItem Content="英文 EN" Tag="EN"/>
                <ComboBoxItem Content="日文 JA" Tag="JA"/>
            </ComboBox>
            <TextBlock Text="  渲染:背景采样覆盖(取文本周围底色原位替换)" VerticalAlignment="Center" Foreground="#666"/>
        </StackPanel>
        <Image x:Name="PreviewImage" Margin="0,12,0,0" MaxHeight="150" Stretch="Uniform"
               SnapsToDevicePixels="True"/>
        <ListBox x:Name="OcrList" Margin="0,8,0,0" MaxHeight="120"
                 FontFamily="Consolas" FontSize="12"/>
        <TextBlock x:Name="StatusText" Margin="0,8,0,0" Foreground="#0a0" Text="就绪" TextWrapping="Wrap"/>
    </StackPanel>
</Window>
